rules_version = '2';

// komovia_reversia Firestore rules. Minimal skeleton for now — this app
// has no social/PvP features yet (see main.dart's doc comment); only the
// base `users/{uid}` profile doc is defined, following the exact
// convention komovia_shogi/komovia_go use for every later feature's rules.
// No Cloud Functions backend exists, so every write here is a direct
// client write; rules restrict *who* can write, not *what* is true.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isEither(a, b) {
      return isSignedIn() && (request.auth.uid == a || request.auth.uid == b);
    }

    function isParticipant(ids) {
      return isSignedIn() && request.auth.uid in ids;
    }

    // message_threads' participantUids is always exactly 2 fixed uids —
    // see message_threads/{threadId}'s own match block below.
    function otherParticipant(ids, uid) {
      return ids[0] == uid ? ids[1] : ids[0];
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------------- users/{uid} ----------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ---------------- users/{uid}/friends/{friendUid} ----------------
    match /users/{uid}/friends/{friendUid} {
      allow read: if isOwner(uid);
      // A request is created by the sender, on BOTH users' subcollections
      // (see friend_service.dart) — so creation of a doc not owned by the
      // caller is allowed only when it records a request THEY sent.
      allow create: if isSignedIn() &&
        (isOwner(uid) || request.resource.data.requestedBy == request.auth.uid);
      // Accept: only the non-sender may flip pending -> accepted.
      // Block: either side may set status -> blocked at any time.
      allow update: if isSignedIn() && (
        (onlyChanged(['status']) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          resource.data.requestedBy != request.auth.uid) ||
        (onlyChanged(['status', 'blockedBy']) &&
          request.resource.data.status == 'blocked')
      );
      allow delete: if isOwner(uid) || isOwner(friendUid);
    }

    // ---------------- reversia_matchmaking_queue/{uid} ----------------
    match /reversia_matchmaking_queue/{queueUid} {
      // The whole queue is scanned client-side to find a candidate.
      allow read: if isSignedIn();
      allow create, delete: if isOwner(queueUid);
      allow update: if isOwner(queueUid) ||
        // ReversiaMatchingService.findMatch flips a candidate's own status.
        (isSignedIn() && onlyChanged(['status']) &&
         resource.data.status == 'waiting' && request.resource.data.status == 'matched');
    }

    // ---------------- reversia_match_results/{matchId} ----------------
    match /reversia_match_results/{matchId} {
      allow read: if isEither(resource.data.player1Uid, resource.data.player2Uid);
      allow create: if isSignedIn() && request.resource.data.player1Uid == request.auth.uid;
      allow update: if isEither(resource.data.player1Uid, resource.data.player2Uid) &&
        onlyChanged(['gameId']);
      allow delete: if false;
    }

    // ---------------- reversia_pvp_games/{gameId} ----------------
    match /reversia_pvp_games/{gameId} {
      allow read: if isEither(resource.data.firstUid, resource.data.secondUid);
      allow create: if isSignedIn() &&
        (request.auth.uid == request.resource.data.firstUid ||
         request.auth.uid == request.resource.data.secondUid);
      // ReversiaPvpGameService.applyMove/resign: either participant may
      // update movesRecord/isFirstTurn/movesCount/status/winnerUid/result.
      allow update: if isEither(resource.data.firstUid, resource.data.secondUid) &&
        onlyChanged(['movesRecord', 'isFirstTurn', 'movesCount', 'status', 'winnerUid', 'result', 'updatedAt']);
      allow delete: if false;
    }

    // ---------------- leaderboards/{period}/{type}/{uid} ----------------
    match /leaderboards/{period}/{type}/{uid} {
      allow read: if isSignedIn();
      // PvP game results update the Elo rating of BOTH players
      // (reversia_pvp_game_provider.dart's _updateReversiaPvpEloRatings),
      // so this can't be restricted to isOwner(uid) — same documented
      // client-trust tradeoff as komovia_go's identical rule (no Cloud
      // Functions backend exists to verify self-reported outcomes yet).
      allow write: if isSignedIn();
    }

    // ---------------- reversia_challenge_codes/{code} ----------------
    match /reversia_challenge_codes/{code} {
      // Codes are looked up by their (random) string, not enumerated, but
      // a guest must be able to read one before they're a participant —
      // same open-read-to-any-signed-in-user tradeoff as the matchmaking
      // queue.
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.guestUid == null &&
        request.resource.data.gameId == null;
      allow update: if isSignedIn() && (
        // ReversiaChallengeService.joinChallenge: a non-host guest claims
        // a still-waiting code as themselves.
        (resource.data.status == 'waiting' &&
         request.resource.data.status == 'matched' &&
         request.auth.uid != resource.data.hostUid &&
         request.resource.data.guestUid == request.auth.uid &&
         onlyChanged(['status', 'guestUid', 'guestDisplayName'])) ||
        // attachGameToChallenge: either participant may attach the
        // created game's id once matched.
        (isEither(resource.data.hostUid, resource.data.guestUid) &&
         onlyChanged(['gameId']))
      );
      allow delete: if false;
    }

    // ---------------- notifications/{uid}/... ----------------
    match /notifications/{uid}/items/{notificationId} {
      allow read: if isOwner(uid);
      // Any signed-in user may send a notification to another user (a
      // pvp_challenge when a match/challenge creates a game) — the
      // recipient uid is fixed by the path, so this can't write anyone
      // else's data.
      allow create: if isSignedIn();
      allow update: if isOwner(uid) && onlyChanged(['isRead', 'readAt']);
      allow delete: if isOwner(uid);
    }

    match /notifications/{uid}/notificationPreferences/{doc} {
      allow read, write: if isOwner(uid);
    }

    // ---------------- reversia_puzzle_logs/{uid}/days/{dateKey} ----------------
    match /reversia_puzzle_logs/{uid}/days/{dateKey} {
      allow read, write: if isOwner(uid);
    }

    // ---------------- message_threads/{threadId} ----------------
    // 1対1のフレンド間DM。threadIdは常に2者のuidをソートして連結した
    // ものなので（DirectMessageService.threadIdFor）、participantUidsは
    // スレッドの生存中ずっと固定の2要素配列 - komovia_chessの
    // `firestore.rules`と同じ設計をそのまま使う。
    match /message_threads/{threadId} {
      allow read: if isParticipant(resource.data.participantUids);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.participantUids.size() == 2;
      // 送信とmarkThreadReadはどちらもこのmerge-setを通るため、2つの
      // 正当な書き込み形だけを許可する: 既読化は自分自身の
      // unreadCountエントリーを0にするだけ（相手のエントリーは不変）、
      // 送信は自分をlastSenderUidにし、相手のunreadCountをちょうど
      // +1する（自分のunreadCountは不変）。
      allow update: if isParticipant(resource.data.participantUids) &&
        request.resource.data.participantUids == resource.data.participantUids &&
        (
          (onlyChanged(['unreadCount']) &&
            request.resource.data.unreadCount[request.auth.uid] == 0 &&
            request.resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)] ==
              resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)])
          ||
          (onlyChanged(['lastMessage', 'lastSenderUid', 'lastMessageAt', 'unreadCount', 'participantNames']) &&
            request.resource.data.lastSenderUid == request.auth.uid &&
            request.resource.data.unreadCount[request.auth.uid] == resource.data.unreadCount[request.auth.uid] &&
            request.resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)] ==
              resource.data.unreadCount[otherParticipant(resource.data.participantUids, request.auth.uid)] + 1)
        );
      allow delete: if false;

      match /messages/{messageId} {
        function threadParticipants() {
          return get(/databases/$(database)/documents/message_threads/$(threadId)).data.participantUids;
        }

        allow read: if isParticipant(threadParticipants());
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.fromUid &&
          isParticipant(threadParticipants());
        allow update, delete: if false;
      }
    }

    // ---------------- tournaments/{tournamentId} ----------------
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      // 参加: participantUidsのみ変更可能で、呼び出し元自身のuidを
      // 追加する場合のみ許可。
      // ブラケット進行(status/winnerId/lastAdvancedRound): これを
      // 担うCloud Functionが無いため、どの参加者からの書き込みも許可
      // する（既知のクライアント信頼ギャップとして記録、バグではない）。
      allow update: if isSignedIn() && (
        (onlyChanged(['participantUids']) &&
          request.resource.data.participantUids.hasAll(resource.data.participantUids) &&
          request.resource.data.participantUids.hasAny([request.auth.uid])) ||
        (onlyChanged(['status', 'winnerId', 'lastAdvancedRound']) &&
          request.auth.uid in resource.data.participantUids)
      );

      match /matches/{matchId} {
        allow read: if isSignedIn();
        // 試合生成/結果報告: トーナメント参加者であれば誰でも可能。
        allow write: if isSignedIn();
      }
    }

    // ---------------- achievements/{uid}/unlocked/{achievementId} ----------------
    match /achievements/{uid}/unlocked/{achievementId} {
      allow read, write: if isOwner(uid);
    }

    // ---------------- premium_entitlements/{uid} ----------------
    // 既知のクライアント信頼ギャップ: App Store/Playの領収書を検証する
    // Cloud Functionsが無いため、クライアントが直接権限を書き込める
    // （GoEnの`subscriptionActive`等と同じ、サーバーレス構成の正直な
    // 限界として記録 - バグではない）。
    match /premium_entitlements/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
